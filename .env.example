# Copy to `.env` and fill in the values you need. `.env` is gitignored.
# start.sh sources this automatically; the CLI also loads it at import time.

# --- Google Gemini ---
GEMINI_API_KEY=

# --- OpenAI-compatible server (local Qwen3 via Ollama / vLLM / LM Studio) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
QWEN_MODEL=qwen3
# OPENAI_API_KEY=   # only set if your server enforces a bearer token

# --- Harness defaults used by start.sh ---
TEST_AGENT_PROVIDER=openai_compatible
TEST_AGENT_MODE=chat
# TEST_AGENT_REPO=/absolute/path/to/your/repo
